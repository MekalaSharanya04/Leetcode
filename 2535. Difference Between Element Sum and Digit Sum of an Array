class Solution {
    public int differenceOfSum(int[] nums) {
        int elesum = 0;
        int digsum = 0;
        for(int i= 0; i < nums.length;i++){
            elesum += nums[i]; 
        }
        for (int num : nums) {
        while(num > 0) {
            digsum += num % 10;
            num = num / 10;
        }
        }
        return Math.abs(elesum - digsum);
    }
}
