class Solution {
    public int concatenatedBinary(int n) {
        int MOD = 1000000007;
        long dp = 0;      
        int bitLength = 0;

        for (int i = 1; i <= n; i++) {
            
            if ((i & (i - 1)) == 0) {
                bitLength++;
            }
           
            dp = ((dp << bitLength) + i) % MOD;
        }

        return (int) dp;
    }
}
