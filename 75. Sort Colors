class Solution {
    public void sortColors(int[] nums) {
        int rcnt = 0;
        int wcnt = 0;
        int bcnt = 0;
        for(int i = 0 ;i < nums.length; i++){
           if(nums[i] == 0){
                rcnt++;
           }else if(nums[i] == 1){
                wcnt++;
           }else{
                bcnt++;
           }
        }
        int idx = 0;
        for(int i = 0; i < rcnt; i++){
            nums[idx] = 0;
            idx++;
        }
        for(int i = 0; i < wcnt; i++){
            nums[idx] = 1;
            idx++;
        }
        for(int i = 0; i < bcnt; i++){
            nums[idx] = 2;
            idx++;
        }
    }
}


or



class Solution {
    public void sortColors(int[] nums) {
        int low = 0;
        int mid = 0;
        int high = nums.length - 1;

        while(mid <= high){
            if(nums[mid] == 0){
                int temp = nums[mid];
                nums[mid] = nums[low];
                nums[low] = temp;
                mid++;
                low++;
            }
            else if(nums[mid] == 1){
                mid++;
            }
            else{
                int temp = nums[mid];
                nums[mid] = nums[high];
                nums[high] = temp;
                
                high--;
            }
        }
    }
}
