class Solution {
    public int findPermutationDifference(String s, String t) {
        int dif = 0;
        char c;
        int idx;
        for(int i = 0; i < s.length(); i++){
            c = s.charAt(i);
            idx = t.indexOf(c);
            dif += Math.abs(i - idx);
        }
        return dif;
    }
}
