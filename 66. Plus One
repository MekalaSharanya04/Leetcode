class Solution {
    public int[] plusOne(int[] digits) {
       
        int n = digits.length;       
        int[] dp = new int[n + 1];        
        int carry = 1;
                
        for (int i = n - 1; i >= 0; i--) {
            int sum = digits[i] + carry;
            dp[i + 1] = sum % 10;
            carry = sum / 10;
        }           
        dp[0] = carry;        
        if (dp[0] == 0) {
            int[] result = new int[n];
            for (int i = 0; i < n; i++) {
                result[i] = dp[i + 1];
            }
            return result;
        }        
        return dp;
    }
}
